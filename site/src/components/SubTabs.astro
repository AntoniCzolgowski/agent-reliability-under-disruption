---
// Tabs inside one page. Without JavaScript this is a row of links to sections that follow each other on the page;
// the script turns it into an ARIA tab list that shows one section at a time and keeps the address bar in step,
// so a link to a section, or to anything inside one, still opens the right tab.
interface Item { id: string; label: string }
interface Props { items: Item[]; label: string }
const { items, label } = Astro.props;
---

<nav class="subtabs" aria-label={label} data-subtabs>
  <ul class="subtabs-list">
    {items.map((it) => <li><a href={`#${it.id}`} data-tab={it.id}>{it.label}</a></li>)}
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-subtabs]");
  const list = nav?.querySelector<HTMLElement>(".subtabs-list");
  const tabs = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>("a[data-tab]")) : [];
  const panels = tabs.map((t) => document.getElementById(t.dataset.tab ?? ""));

  if (nav && list && tabs.length && panels.every((p) => p)) {
    const ps = panels as HTMLElement[];
    list.setAttribute("role", "tablist");
    list.querySelectorAll("li").forEach((li) => li.setAttribute("role", "presentation"));
    tabs.forEach((t, i) => {
      t.setAttribute("role", "tab");
      t.id = `tab-${ps[i].id}`;
      t.setAttribute("aria-controls", ps[i].id);
      ps[i].setAttribute("role", "tabpanel");
      ps[i].setAttribute("aria-labelledby", t.id);
    });
    document.documentElement.classList.add("has-subtabs");

    const top = () => nav.getBoundingClientRect().top + window.scrollY;
    const select = (i: number, o: { focus?: boolean; scroll?: boolean; hash?: boolean } = {}) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        ps[j].hidden = !on;
      });
      if (o.focus) tabs[i].focus();
      if (o.hash) history.replaceState(null, "", `#${ps[i].id}`);
      if (o.scroll && window.scrollY > top()) window.scrollTo({ top: top() });
    };
    // which tab holds the element the address points to, if any
    const target = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const el = id ? document.getElementById(id) : null;
      const k = el ? ps.findIndex((p) => p === el || p.contains(el)) : -1;
      return k < 0 ? null : { k, el: el as HTMLElement };
    };

    const start = target();
    select(start ? start.k : 0);
    if (start && start.el !== ps[start.k]) requestAnimationFrame(() => start.el.scrollIntoView());

    tabs.forEach((t, i) => t.addEventListener("click", (e) => { e.preventDefault(); select(i, { scroll: true, hash: true }); }));
    list.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const k = e.key === "ArrowRight" ? (i + 1) % tabs.length
        : e.key === "ArrowLeft" ? (i - 1 + tabs.length) % tabs.length
        : e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1
        : e.key === " " ? i : -1;
      if (k < 0) return;
      e.preventDefault();
      select(k, { focus: true, hash: true });
    });
    window.addEventListener("hashchange", () => {
      const t = target();
      if (!t) return;
      select(t.k);
      if (t.el !== ps[t.k]) t.el.scrollIntoView();
    });
  }
</script>
