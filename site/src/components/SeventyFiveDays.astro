---
// Seventy-five days: one ridge per day, the share of the 25,000 people with a record in each half-hour.
// Data: src/data/day_curves.json, exported from the analysis table (all people, all days).
import data from "../data/day_curves.json";

interface Props { n?: number | string; title?: string; }
const { n = 1, title = "Seventy-five days" } = Astro.props;

const M: number[][] = data.M;
const W = 1600, H = 1320, left = 150, right = 60, top = 40, rowGap = 12, amp = 260;
const plotW = W - left - right;
const x = (t: number) => left + (t / 47) * plotW;
const base = (d: number) => top + d * rowGap + amp;
function ridge(d: number) {
  const row = M[d];
  let s = `M ${x(0).toFixed(1)} ${(base(d) - row[0] * amp).toFixed(1)}`;
  for (let t = 1; t < 48; t++) s += ` L ${x(t).toFixed(1)} ${(base(d) - row[t] * amp).toFixed(1)}`;
  return `${s} L ${x(47).toFixed(1)} ${base(d).toFixed(1)} L ${x(0).toFixed(1)} ${base(d).toFixed(1)} Z`;
}
const dayLabels = [{ d: 0, text: "day 1" }, { d: 59, text: "day 60" }, { d: 74, text: "day 75" }];
const hourLabels = [[0, "midnight"], [12, "6 am"], [24, "noon"], [36, "6 pm"], [47, "midnight"]] as const;
const mono = 'font:400 22px "Chivo Mono", ui-monospace, monospace; fill:#5B616B';
const alt = "Seventy-five stacked lines, one per day, each rising during the day and falling at night. The first sixty lines are blue and the last fifteen red. Every seventh pair of lines rises less, and the red lines rise less than the blue ones.";
---

<figure class="days" id={`fig-figure-${n}`}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt} style="display:block;width:100%;height:auto">
    {M.map((_, d) => <path d={ridge(d)} fill="#FCFCFA" stroke={d < 60 ? "#1F4FD8" : "#E8412A"} stroke-width="1.6" stroke-linejoin="round" />)}
    {dayLabels.map((l) => <text style={mono} x={left - 24} y={base(l.d) + 7} text-anchor="end">{l.text}</text>)}
    <line x1={left} x2={W - right} y1={base(74) + 36} y2={base(74) + 36} stroke="#D9DAD6" />
    {hourLabels.map(([t, text]) => <text style={mono} x={x(t)} y={base(74) + 72} text-anchor="middle">{text}</text>)}
  </svg>
  <figcaption>
    <span class="fig-no">Figure {n}</span><span class="fig-title">{title}</span>
    <span class="fig-text"><slot /></span>
  </figcaption>
</figure>

<style>
  .days { margin: 2.4rem 0 2.6rem; }
</style>
