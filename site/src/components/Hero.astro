---
// The interactive figure on Home. The still paints first; three.js loads only when the figure is in view
// (or after a tap on phones), and the still stays under reduced motion or without WebGL.
import { Image } from "astro:assets";
import { url } from "../site";
import still from "../assets/hero-still.png";

// Screen-reader label for the canvas; the poster is decorative so no text ever shows in its place.
const label = "Interactive landscape of the city's 200 by 200 grid: the height of each ridge is how many people are observed in that cell at the time on the clock, on an ordinary or an emergency workday.";
---

<figure class="hero" id="hero" data-data-url={url("data/")}>
  <div class="hero-stage">
    <Image class="hero-still" src={still} alt="" widths={[800, 1400, still.width]} sizes="100vw" loading="eager" fetchpriority="high" />
    <canvas class="hero-canvas" role="img" aria-label={label}></canvas>
    <div class="hero-ui frame">
      <div class="hero-clock" aria-hidden="true"><span id="hero-clock">4:00 AM</span></div>
      <div class="hero-toggle" role="group" aria-label="Kind of day">
        <button type="button" data-cond="ordinary" aria-pressed="true">Ordinary</button>
        <button type="button" data-cond="emergency" aria-pressed="false">Emergency</button>
      </div>
    </div>
    <button class="hero-tap" type="button" hidden>Tap to explore</button>
    <p class="hero-fallback" hidden>The interactive figure needs WebGL. The image shows 08:00 on an ordinary workday.</p>
  </div>
  <div class="hero-bar">
    <button class="hero-play" type="button" aria-label="Pause" disabled>
      <svg class="ic-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1" width="3" height="10" /><rect x="7.5" y="1" width="3" height="10" /></svg>
      <svg class="ic-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" /></svg>
    </button>
    <label class="hero-scrub-label"><span class="visually-hidden">Time of day</span>
      <input class="hero-scrub" type="range" min="0" max="1439" step="1" value="240" disabled />
    </label>
  </div>
  <div class="hero-slice" aria-hidden="true" hidden>
    <svg viewBox="0 0 1000 220" preserveAspectRatio="none">
      <path class="slice-ghost" d="" />
      <path class="slice-fill" d="" />
      <path class="slice-line" d="" />
    </svg>
    <p class="slice-note frame"><span>one row, 200 cells, 100 km</span></p>
  </div>
</figure>

<script>
  const fig = document.getElementById("hero") as HTMLElement;
  const canvas = fig.querySelector<HTMLCanvasElement>(".hero-canvas")!;
  const clock = fig.querySelector<HTMLElement>("#hero-clock")!;
  const playBtn = fig.querySelector<HTMLButtonElement>(".hero-play")!;
  const scrub = fig.querySelector<HTMLInputElement>(".hero-scrub")!;
  const tap = fig.querySelector<HTMLButtonElement>(".hero-tap")!;
  const fallback = fig.querySelector<HTMLElement>(".hero-fallback")!;
  const toggles = Array.from(fig.querySelectorAll<HTMLButtonElement>(".hero-toggle button"));
  const sliceBox = fig.querySelector<HTMLElement>(".hero-slice")!;
  const sliceGhost = fig.querySelector<SVGPathElement>(".slice-ghost")!;
  const sliceFill = fig.querySelector<SVGPathElement>(".slice-fill")!;
  const sliceLine = fig.querySelector<SVGPathElement>(".slice-line")!;

  const params = new URLSearchParams(location.search);
  const style = params.get("style") === "columns" ? "columns" : "ridges";
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const coarse = matchMedia("(pointer: coarse)").matches;
  const test = document.createElement("canvas");
  const webgl = !!(test.getContext("webgl2") || test.getContext("webgl"));

  let hero: import("../scripts/hero").HeroHandle | null = null;
  let scrubbing = false;

  function showStill() { fig.classList.remove("is-live"); fig.classList.add("is-still"); }
  function setPlaying(p: boolean) {
    playBtn.classList.toggle("is-playing", p);
    playBtn.setAttribute("aria-label", p ? "Pause" : "Play");
  }
  function onTime(slot: number) {
    const minutes = Math.floor(slot * 30), h = Math.floor(minutes / 60);
    clock.textContent = `${((h + 11) % 12) + 1}:${String(minutes % 60).padStart(2, "0")} ${h < 12 ? "AM" : "PM"}`;
    if (!scrubbing) scrub.value = String(minutes);
  }

  // the slice under the bar: the same row of the city, cut open, moving with the clock and the toggle
  const COBALT = [31, 79, 216], VERMILION = [232, 65, 42];
  function slicePath(v: Float32Array, max: number, close: boolean) {
    const n = v.length, W = 1000, H = 220, top = 12;
    let d = "";
    for (let i = 0; i < n; i++) {
      const x = (i / (n - 1)) * W, y = H - ((v[i] / max) * (H - top));
      d += (i ? " L " : "M ") + x.toFixed(1) + " " + y.toFixed(1);
    }
    return close ? d + ` L ${W} ${H} L 0 ${H} Z` : d;
  }
  function onSlice(h: Float32Array, g: Float32Array, mix: number, max: number) {
    const c = COBALT.map((a, i) => Math.round(a + (VERMILION[i] - a) * mix));
    const col = `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
    sliceLine.setAttribute("d", slicePath(h, max, false)); sliceLine.style.stroke = col;
    sliceFill.setAttribute("d", slicePath(h, max, true)); sliceFill.style.fill = col;
    sliceGhost.setAttribute("d", slicePath(g, max, false)); sliceGhost.style.opacity = String(0.35 * mix);
  }

  async function start() {
    if (hero || !webgl) return;
    fig.classList.add("is-loading");
    const mod = await import("../scripts/hero");
    hero = await mod.mountHero(canvas, {
      style, dataUrl: fig.dataset.dataUrl!, autoplay: !reduced, idleRotation: !reduced, startSlot: 8,
      onTime,
      onReady() {
        fig.classList.remove("is-loading", "is-still"); fig.classList.add("is-live");
        playBtn.disabled = false; scrub.disabled = false; setPlaying(!reduced);
      },
      onLost() { showStill(); playBtn.disabled = true; sliceBox.hidden = true; },
      sliceRow: 82, onSlice,
    });
    sliceBox.hidden = false;
    if (params.has("debug")) (window as any).__hero = hero;
  }

  if (!webgl) {
    showStill(); fallback.hidden = false;
  } else if (coarse) {
    showStill(); tap.hidden = false;
    tap.addEventListener("click", () => { tap.hidden = true; fig.classList.add("is-touch"); start(); }, { once: true });
  } else {
    fig.classList.add("is-still");
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
    }, { rootMargin: "200px" });
    io.observe(fig);
  }

  playBtn.addEventListener("click", () => {
    if (!hero) return;
    if (hero.playing()) hero.pause(); else hero.play();
    setPlaying(hero.playing());
  });
  fig.addEventListener("keydown", (e) => {
    if (e.code !== "Space" || !hero) return;
    const t = e.target as HTMLElement;
    if (t.tagName === "INPUT" || (t.tagName === "BUTTON" && t !== playBtn)) return;
    e.preventDefault(); playBtn.click();
  });
  scrub.addEventListener("pointerdown", () => { scrubbing = true; });
  scrub.addEventListener("input", () => { hero?.seek(Number(scrub.value) / 30); });
  scrub.addEventListener("change", () => { scrubbing = false; hero?.seek(Number(scrub.value) / 30); });
  toggles.forEach((b) => b.addEventListener("click", () => {
    toggles.forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
    hero?.setCondition(b.dataset.cond === "emergency");
  }));

  // pause when the tab is hidden or the figure leaves the screen
  let wasPlaying = false;
  const vis = new IntersectionObserver((entries) => {
    if (!hero) return;
    const on = entries.some((e) => e.isIntersecting);
    if (!on && hero.playing()) { wasPlaying = true; hero.pause(); }
    else if (on && wasPlaying) { wasPlaying = false; hero.play(); }
  });
  vis.observe(fig);
  document.addEventListener("visibilitychange", () => {
    if (!hero) return;
    if (document.hidden && hero.playing()) { wasPlaying = true; hero.pause(); }
    else if (!document.hidden && wasPlaying) { wasPlaying = false; hero.play(); }
  });
  window.addEventListener("pagehide", () => hero?.dispose());
</script>

<style>
  /* full-bleed: the figure runs from one edge of the window to the other, the bar stays in the text frame */
  .hero { margin: 0 0 2.5rem; max-width: none; }
  .hero-stage {
    position: relative; width: calc(100vw - var(--sbw, 0px)); margin-left: calc(50% - 50vw + var(--sbw, 0px) / 2);
    height: clamp(24rem, 82vh, 58rem); overflow: hidden; background: var(--ground);
  }
  /* clock and toggle sit on the text frame's gutters, not on the window edge */
  .hero-ui { position: absolute; inset: 0; pointer-events: none; }
  @media (max-width: 47.99rem) { .hero-stage { height: clamp(18rem, 64vh, 34rem); } }
  .hero-still, .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-still { object-fit: cover; object-position: center; transition: opacity 400ms ease; }
  .hero-canvas { display: block; opacity: 0; transition: opacity 400ms ease; touch-action: pan-y; cursor: grab; }
  .hero.is-live .hero-canvas { opacity: 1; }
  .hero.is-live .hero-still { opacity: 0; pointer-events: none; }
  .hero.is-touch .hero-canvas { touch-action: none; }
  .hero-canvas.is-dragging { cursor: grabbing; }

  .hero-clock {
    position: absolute; left: var(--gutter); top: clamp(0.8rem, 2.4vw, 1.6rem);
    font: 400 clamp(1.4rem, 3.2vw, 2.2rem)/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--ink); pointer-events: none;
  }
  .hero-toggle { position: absolute; right: var(--gutter); top: clamp(0.8rem, 2.4vw, 1.6rem); display: flex; border: 1px solid var(--ink); pointer-events: auto; }
  .hero-toggle button {
    font: 500 0.85rem/1 var(--sans); padding: 0.55rem 0.8rem; background: var(--ground); color: var(--ink);
    border: 0; cursor: pointer;
  }
  .hero-toggle button + button { border-left: 1px solid var(--ink); }
  .hero-toggle button[aria-pressed="true"] { background: var(--ink); color: var(--ground); }
  .hero-toggle button:focus-visible { outline-offset: -3px; outline-color: var(--ground); }
  .hero-toggle button[aria-pressed="false"]:focus-visible { outline-color: var(--cobalt); }

  .hero-tap {
    position: absolute; left: 50%; bottom: 12%; transform: translateX(-50%);
    font: 500 0.95rem/1 var(--sans); padding: 0.8rem 1.2rem; background: var(--ink); color: var(--ground); border: 0; cursor: pointer;
  }
  .hero-fallback { position: absolute; left: 1rem; bottom: 0.6rem; margin: 0; font: 400 0.85rem/1.4 var(--sans); color: var(--muted); }

  .hero-bar { display: flex; align-items: center; gap: 1rem; padding-top: 0.7rem; }

  /* the slice: full-bleed, quiet, bottom-aligned skyline of one row */
  .hero-slice { position: relative; width: calc(100vw - var(--sbw, 0px)); margin: 3.5rem 0 0 calc(50% - 50vw + var(--sbw, 0px) / 2); }
  .hero-slice svg { display: block; width: 100%; height: clamp(9rem, 26vh, 17rem); overflow: visible; }
  .hero-slice path { vector-effect: non-scaling-stroke; }
  .slice-line { fill: none; stroke: var(--cobalt); stroke-width: 1.4; stroke-linejoin: round; opacity: 0.55; }
  .slice-fill { stroke: none; fill: var(--cobalt); opacity: 0.06; }
  .slice-ghost { fill: none; stroke: var(--cobalt); stroke-width: 1.2; stroke-linejoin: round; opacity: 0; }
  .slice-note { margin: 0.5rem auto 0; font: 400 0.8rem/1.2 var(--mono); color: var(--muted); }
  .hero.is-touch .hero-slice, .hero.is-live .hero-slice { display: block; }
  .hero-play {
    display: grid; place-items: center; width: 1.9rem; height: 1.9rem; padding: 0; background: none; color: var(--ink);
    border: 1px solid var(--ink); cursor: pointer;
  }
  .hero-play svg { fill: currentColor; display: none; }
  .hero-play.is-playing .ic-pause, .hero-play:not(.is-playing) .ic-play { display: block; }
  .hero-play:disabled { color: var(--muted); border-color: var(--rule); cursor: default; }
  .hero-scrub-label { flex: 1; display: flex; }
  .hero-scrub { flex: 1; -webkit-appearance: none; appearance: none; height: 1.4rem; background: none; margin: 0; cursor: pointer; }
  .hero-scrub:disabled { cursor: default; }
  .hero-scrub::-webkit-slider-runnable-track { height: 1px; background: var(--rule); }
  .hero-scrub::-moz-range-track { height: 1px; background: var(--rule); }
  .hero-scrub::-webkit-slider-thumb { -webkit-appearance: none; width: 2px; height: 14px; margin-top: -6.5px; background: var(--ink); border-radius: 0; }
  .hero-scrub::-moz-range-thumb { width: 2px; height: 14px; background: var(--ink); border: 0; border-radius: 0; }
  .hero-scrub:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 4px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
