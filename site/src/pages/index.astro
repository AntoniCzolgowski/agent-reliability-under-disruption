---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { url } from "../site";

const description =
  "A course and research project on simulated stand-ins for real people, and how well they hold up when an emergency interrupts daily life.";
---

<Base description={description} current="home">
  <Hero />
  <p class="lede home-line">When people's lives change, can the agents representing them keep up?</p>
  <p class="note">Start with the <a href={url("introduction/")}>Introduction</a>.</p>
</Base>

<style>
  .home-line { margin-top: 2.6rem; }
</style>
